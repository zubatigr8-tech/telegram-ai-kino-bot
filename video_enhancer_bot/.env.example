# --- Telegram ---
# @BotFather orqali olingan YANGI bot tokeni (kino bot tokeni emas!)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# --- Sifatni oshirish usuli ---
# ffmpeg     — bepul, GPU kerak emas (standart)
# realesrgan — AI (Real-ESRGAN), eng yaxshi natija, GPU'li server kerak
# replicate  — bulutdagi AI (Topaz va b.), pullik, REPLICATE_API_TOKEN kerak
ENGINE=ffmpeg

# Natija balandligi: 720, 1080, 1440, 2160
TARGET_HEIGHT=1080
# Eng uzun video (soniya)
MAX_DURATION_SEC=180
# Bir vaqtda nechta video ishlanadi
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=20
JOB_TIMEOUT_SEC=3600
# Sifat/tezlik: ultrafast, veryfast, fast, medium, slow, slower
X264_PRESET=medium
# ffmpeg oqimlari (ko'proq = tezroq, lekin ko'proq xotira; 1 GB server uchun 2)
FFMPEG_THREADS=2

# --- Katta fayllar (ixtiyoriy) ---
# Oddiy Telegram API: botga 20 MB gacha video yuborish mumkin, bot 50 MB gacha qaytaradi.
# Local Bot API server (https://github.com/tdlib/telegram-bot-api) ishlatsangiz — 2 GB gacha.
# TELEGRAM_API_URL=http://localhost:8081
# TELEGRAM_API_LOCAL=true

# --- Real-ESRGAN (ENGINE=realesrgan) ---
# REALESRGAN_BIN=/opt/realesrgan/realesrgan-ncnn-vulkan
# realesrgan-x4plus (SCALE=4) — real kinolar uchun eng tabiiy; tezroq variant: realesr-animevideov3 (SCALE=2)
# REALESRGAN_MODEL=realesrgan-x4plus
# REALESRGAN_SCALE=4
# REALESRGAN_GPU=0

# --- Replicate (ENGINE=replicate) ---
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_MODEL=topazlabs/video-upscale
# REPLICATE_VIDEO_FIELD=video
# REPLICATE_EXTRA_INPUT={"target_resolution": "1080p"}

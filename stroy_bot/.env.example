# Bu faylni nusxalab, nomini .env qiling:  stroy_bot/.env

# @BotFather orqali olingan YANGI bot tokeni (kino bot tokeni emas)
STROY_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Zayavkalar keladigan sotuvchi/do'kon egasining Telegram ID raqami(lari), vergul bilan.
# ID ni bilish uchun botga /myid yuboring.
STROY_ADMIN_IDS=123456789

# Claude API kaliti: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Ixtiyoriy sozlamalar
# STROY_AI_MODEL=claude-opus-5-5
# STROY_AI_EFFORT=low
# STROY_HISTORY_LIMIT=20

# --- Telegram ---
# @BotFather orqali olingan bot tokeni
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Bot adminlarining Telegram ID raqamlari, vergul bilan ajratilgan
# ID ni bilish uchun botga /myid buyrug'ini yuboring
ADMIN_IDS=123456789

# --- Ma'lumotlar bazasi ---
# Standart holatda SQLite ishlatiladi, alohida sozlash shart emas.
# Hostingga (Railway va h.k.) joylashtirganda, doimiy volume yo'liga o'zgartiring,
# masalan: DATABASE_URL=sqlite+aiosqlite:////data/bot_database.db
DATABASE_URL=sqlite+aiosqlite:///./bot_database.db
# Zaxira nusxalar joyi. Hostingda: BACKUP_DIR=/data/backups
BACKUP_DIR=./backups

# --- Admin veb-panel ---
ADMIN_PANEL_SECRET_KEY=iltimos-shu-yerni-tasodifiy-matnga-almashtiring
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=admin123
ADMIN_PANEL_HOST=0.0.0.0
ADMIN_PANEL_PORT=8000

# --- Antiradar bot (antiradar/README.md) ---
# Alohida bot: @BotFather'da yangi bot yarating
ANTIRADAR_BOT_TOKEN=
# Bo'sh qoldirilsa ADMIN_IDS ishlatiladi
ANTIRADAR_ADMIN_IDS=
# Oylik obuna narxi (Telegram Stars) va bepul sinov kunlari
ANTIRADAR_PRICE_STARS=100
ANTIRADAR_TRIAL_DAYS=3
# Ovozli ogohlantirish (avval ovoz, keyin matn). false — faqat matn
ANTIRADAR_VOICE=true
# OpenStreetMap'dan radar va belgilarni necha soatda bir yangilash (0 — o'chirilgan)
ANTIRADAR_OSM_REFRESH_HOURS=24
